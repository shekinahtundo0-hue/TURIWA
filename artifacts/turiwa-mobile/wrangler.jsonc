{
  "name": "turiwa-mobile",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Pages serves `node:http` from unenv's stub, so the Express API cannot run here. It runs in
  // the `turiwa-api` Worker instead and `/api/*` reaches it through this service binding, which
  // keeps the browser on its own origin and needs no public API hostname.
  "services": [
    {
      "binding": "API",
      "service": "turiwa-api"
    }
  ]
}
