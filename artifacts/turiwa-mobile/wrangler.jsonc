{
  "name": "turiwa-api",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "DATABASE_POOL_MAX": "2"
  }
}
