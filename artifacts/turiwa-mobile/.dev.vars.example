# Copy this file to .dev.vars for local `wrangler pages dev` configuration.
# Never commit real database credentials.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
DATABASE_SSL=true
# Alternatively, set DATABASE_URL to your project's transaction-pooler URI.
