PORT=5000
EXPO_PUBLIC_API_URL=http://localhost:5000

# Local embedded database (used when SUPABASE_DB_PASSWORD is empty)
DATABASE_URL=pglite://data/turiwa

# Supabase API
SUPABASE_URL=https://adxqhuypkpoekifqjadu.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
EXPO_PUBLIC_SUPABASE_URL=https://adxqhuypkpoekifqjadu.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Supabase Postgres, through the session pooler.
#
# `db.<ref>.supabase.co` has no A record on projects created after mid-2024 — it is IPv6 only,
# so a Netlify or Vercel container fails it with ENOTFOUND before it ever checks the password.
# The pooler is the IPv4 route, and it needs the project reference appended to the username to
# find the tenant. Region here is proven, not assumed: only aws-0-eu-west-1 resolves tenant
# adxqhuypkpoekifqjadu, while us-east-1 and eu-central-1 answer "tenant/user not found".
SUPABASE_DB_HOST=aws-0-eu-west-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.adxqhuypkpoekifqjadu
SUPABASE_DB_PASSWORD=
DATABASE_SSL=true

# Or a full URI (percent-encode special characters in the password):
# DATABASE_URL=postgresql://postgres.adxqhuypkpoekifqjadu:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# Firebase Google sign-in (optional — phone + password works without these).
# Copy the values from Firebase Console > Project settings > Your apps > Web app.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
GOOGLE_CLIENT_ID=
