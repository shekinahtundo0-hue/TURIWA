PORT=5000
EXPO_PUBLIC_API_URL=http://localhost:5000

# Local embedded database. For Supabase/Postgres, use your current project's connection details.
DATABASE_URL=pglite://data/turiwa

# Supabase API
SUPABASE_URL=https://adxqhuypkpoekifqjadu.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
EXPO_PUBLIC_SUPABASE_URL=https://adxqhuypkpoekifqjadu.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Supabase Postgres, through the session pooler.
# The pooler host is the IPv4-compatible route, and the username needs the project ref suffix.
SUPABASE_DB_HOST=aws-0-eu-west-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.adxqhuypkpoekifqjadu
SUPABASE_DB_PASSWORD=
DATABASE_SSL=true

# Or set DATABASE_URL to the full transaction-pooler URI (percent-encode special characters
# in the password). Use this as a Cloudflare Worker secret, not a build variable.

# Firebase Google sign-in. EXPO_PUBLIC_* values are public client configuration compiled into
# the web app. Set the same values as Cloudflare Pages Production build variables.
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyBZxvTRthNQdVDOOMJS0R5ZWnoY3OR2SiY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=turiwa-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=turiwa-app
EXPO_PUBLIC_FIREBASE_APP_ID=1:148950151181:web:33c1333cb8a8c3392b2544
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=turiwa-app.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=148950151181

# Server-side Google-token verification. Set these as Pages Function runtime variables.
FIREBASE_API_KEY=AIzaSyBZxvTRthNQdVDOOMJS0R5ZWnoY3OR2SiY
FIREBASE_PROJECT_ID=turiwa-app
# Set this to the Web OAuth client ID from Google Cloud Console > APIs & Services > Credentials.
GOOGLE_CLIENT_ID=
